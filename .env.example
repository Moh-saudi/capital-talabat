# Public Firebase Web config. Set all values for a project you own.
# Missing values fall back to the capital-talabat web configuration.
VITE_FIREBASE_API_KEY=AIzaSyCTgSsfVgXrd4d79-wpRtCBY-biXnVTeM8
VITE_FIREBASE_PROJECT_ID=capital-talabat
VITE_FIREBASE_AUTH_DOMAIN=capital-talabat.firebaseapp.com
VITE_FIREBASE_APP_ID=1:462331103510:web:b48e42c27667fcdee9e837
VITE_FIREBASE_DATABASE_ID=(default)
VITE_FIREBASE_STORAGE_BUCKET=capital-talabat.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=462331103510

# Server-only Firebase Admin credentials. Enter securely in Vercel settings.
# NEVER prefix private credentials with VITE_ or commit a service account JSON.
FIREBASE_PROJECT_ID=capital-talabat
FIREBASE_DATABASE_ID=(default)
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Optional authenticated assistant/audio features.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# ☁️ Cloudflare R2 Object Storage (Food Court Images & Menus)
CLOUDFLARE_R2_BUCKET=capitaltalabat
CLOUDFLARE_R2_ACCOUNT_ID=14521cdfec73fa908fbf7e760fae362a
CLOUDFLARE_R2_S3_API=https://14521cdfec73fa908fbf7e760fae362a.r2.cloudflarestorage.com
# Copy the actual enabled public bucket URL or custom domain from Cloudflare.
# The public URL cannot be inferred from the account ID or the S3 endpoint.
CLOUDFLARE_R2_PUBLIC_URL=
CLOUDFLARE_R2_ACCESS_KEY_ID=
CLOUDFLARE_R2_SECRET_ACCESS_KEY=

# HTTPS backend for bundled Capacitor builds (web uses same-origin API).
VITE_API_ORIGIN=https://capital-talabat.vercel.app
APP_URL=https://capital-talabat.vercel.app

# Optional: official HTTPS Flutter release/store URL. Leave blank until published.
VITE_MOBILE_APP_URL=

# Public website interest form. Public endpoint; never put a private token here.
VITE_SIGNUP_URL=https://script.google.com/macros/s/AKfycbzxm2uRZPAyHLKCpfNc6xjvvPIxFsmrmz6APlXoIZlGTPAxdMgG23IoBMwxj4C3cj-7dA/exec
